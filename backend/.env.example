# Copy to backend/.env (or set in the environment). Every setting has a sensible default.

# OpenRouter key for cell fallback, section summaries and explanations.
# Also read from the repo-root .env. Without it the app runs with template summaries/explanations.
OPENROUTER_API_KEY=

# openrouter | fake (deterministic, for tests/E2E) | off
SBCX_LLM_MODE=openrouter
SBCX_MODEL_FALLBACK=deepseek/deepseek-v4-flash
SBCX_MODEL_SUMMARY=deepseek/deepseek-v4-flash
SBCX_MODEL_EXPLANATION=deepseek/deepseek-v4-flash
# "Describe your year": turns a plain-language description into usage events. The text is sent only when the
# user presses Interpret, is never cached or stored, and goes only to providers that don't collect data.
SBCX_MODEL_INTAKE=deepseek/deepseek-v4-flash
SBCX_INTAKE_ENABLED=false
# Stop LLM calls once this much has been spent by one process (USD)
SBCX_LLM_BUDGET_USD=2.0

# Storage: SQLite file, uploaded PDFs, layout and LLM caches
SBCX_VAR_DIR=./var
# SBCX_DATABASE_URL=sqlite:///./var/sbcx.db

# Privacy: delete saved comparisons (premiums, ages, usage) older than N days at startup and with
# `sbcx purge-comparisons`. Unset keeps them until the user deletes them on the Saved page.
# SBCX_COMPARISON_RETENTION_DAYS=30

# Extraction
SBCX_FALLBACK_ENABLED=true
SBCX_CONFIDENCE_THRESHOLD=0.75
SBCX_SUMMARIES_ENABLED=true
SBCX_MAX_UPLOAD_MB=10

SBCX_LOG_LEVEL=INFO
SBCX_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
